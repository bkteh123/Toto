# Railway build: context is the REPO ROOT (so the seed CSV can be baked in).
# Select it on the service with  RAILWAY_DOCKERFILE_PATH=backend/Dockerfile.railway
# docker-compose uses backend/Dockerfile instead and is unaffected.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    COLLECTOR_CACHE_DIR=/data/collector_cache \
    SEED_CSV=/seed/mega645.csv

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install -r requirements.txt

COPY backend/alembic.ini .
COPY backend/alembic ./alembic
COPY backend/app ./app
COPY backend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY seed /seed

RUN useradd --system --create-home --uid 10001 royal \
    && mkdir -p /data/collector_cache \
    && chown -R royal /data \
    && chmod +x /usr/local/bin/docker-entrypoint.sh
USER royal

# Railway's private network is IPv6, so listen on "::" (dual-stack accepts IPv4 too).
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["sh", "-c", "exec uvicorn app.main:app --host :: --port ${PORT:-8000}"]
