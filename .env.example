# Copy to .env and adjust. docker-compose.yml reads these too.
POSTGRES_USER=royal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=royal_yellow

# SQLAlchemy URL used by the backend (inside Docker the host is "db").
DATABASE_URL=postgresql+psycopg://royal:change-me@localhost:5432/royal_yellow

# Collector politeness: minimum seconds between requests to one site.
COLLECTOR_MIN_INTERVAL_SECONDS=5
COLLECTOR_USER_AGENT=RoyalYellowAnalyzer/0.1 (+https://codencode.my; historical-analysis research tool)
# Set to false to disable the scheduled result updates.
SCHEDULER_ENABLED=true
